CC = cc
CFLAGS = -I/opt/homebrew/opt/readline/include -L/opt/homebrew/opt/readline/lib -lreadline
NAME = minishell
SRCS = builtin_cd.c \
		builtin_echo.c \
		builtin_env.c \
		builtin_exit.c \
		builtin_export.c \
		builtin_pwd.c \
		builtin_unset.c \
		builtin_utils.c \
		execute_builtin.c \
		execute_heredoc.c \
		execute_non_builtin.c \
		execute_redir1.c \
		execute_redir2.c \
		free_action.c \
		get_command_path.c \
		init_redir.c \
		libft_expans1.c \
		libft_expans2.c \
		parse_cmd1.c \
		parse_cmd2.c \
		parse_cmd3.c \
		parse_left_redir.c \
		parse_right_redir.c \
		parse_utils.c \
		preset_execute.c \
		preset_str.c \
		put_msg.c \
		set_proc_date.c \
		set_prompt.c \
		signal1.c \
		signal2.c \
		validate_utils.c \
		main.c


OBJS = $(SRCS:.c=.o)

%.o: %.c
	@$(CC) $(CFLAGS) -c $< -o $@

all: $(NAME)

$(NAME): $(OBJS)
			@make -C libft
			@$(CC) $(CFLAGS) -o $(NAME) $(OBJS) libft/libft.a

clean:
	@rm -rf $(OBJS)

fclean: clean
	@rm -rf $(NAME)

re: fclean all


.PHONY: all clean fclean re 